# ============================================================
# Commerce — Variables d'environnement
# Copier ce fichier vers .env.local et remplir les valeurs.
# Ne JAMAIS commiter .env.local
# ============================================================

# --- Base de données MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<utilisateur>:<motdepasse>@<cluster>.mongodb.net/commerce?retryWrites=true&w=majority

# --- Authentification (Auth.js / NextAuth v5) ---
# Générer avec: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Stripe (paiement) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Emails transactionnels (SMTP) ---
# Serveur : mail.perrierbois.fr (ou mail97.lwspanel.com)
# SMTP_PASSWORD = mot de passe du compte email utilisé en SMTP_USER
SMTP_HOST=mail.perrierbois.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@perrierbois.fr
SMTP_PASSWORD=
EMAIL_FROM=Perrier Bois <contact@perrierbois.fr>

# --- Coordonnées affichées sur le site (page contact, footer, emails) ---
CONTACT_EMAIL=contact@perrierbois.fr
CONTACT_TELEPHONE=+33 6 12 34 56 78
CONTACT_ADRESSE=109 Zone des Varennes, 71340 Melay, France

# --- Stockage d'images (Vercel Blob) ---
# Token depuis Vercel > Storage > Blob (accès lecture/écriture)
BLOB_READ_WRITE_TOKEN=

# --- Application ---
NEXT_PUBLIC_APP_URL=https://www.perrierbois.fr
NEXT_PUBLIC_SITE_URL=https://www.perrierbois.fr
# Compte administrateur initial créé par le script de seed (src/scripts/seed.ts)
SEED_ADMIN_EMAIL=contact@perrierbois.fr
SEED_ADMIN_PASSWORD=ChangezMoi123!
# Sur Vercel, le seed ne ré-écrit le catalogue que si la base est vide.
# Mettre SEED_FORCE=true uniquement pour forcer une ré-écriture.
SEED_FORCE=false
